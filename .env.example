# Meridian — copy to .env and adjust. Nothing here is a secret by default; never commit a real key.

# ---- Conductor LLM (free). Any OpenAI-compatible endpoint works. Default: local Ollama.
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Free cloud alternatives (sign up, then paste a key):
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=...

# ---- Market / replay (NSE India)
REPLAY_DEFAULT=true            # start on the recorded NSE session (works any time of day)
REPLAY_DATE=2026-11-11
REPLAY_START=09:25
REPLAY_SPEED=20
MERIDIAN_MODE_DEFAULT=advise   # observe | advise | autopilot (autopilot still needs an on-screen mandate)
ZERODHA_CLONE_URL=            # optional: http://localhost:3002 mirrors every paper fill into your local Zerodha clone (loopback only)
MERIDIAN_BROKER=mock           # paper exchange only — there is no live-broker code path

# ---- Voice
TTS_URL=http://127.0.0.1:8102  # OmniVoice service (voice-tts/server.py)
TTS_THREADS=6                  # CPU threads for OmniVoice; leave half your cores for the core + Whisper
VOICE_ENGINE=auto              # auto | omnivoice | browser — one voice for the whole session (auto = OmniVoice only on fast hardware)
STT_MODEL=base.en              # faster-whisper model: tiny.en | base.en | small.en (local, offline)
STT_ENABLED=true

# ---- Security
MERIDIAN_TOKEN=                # set to require x-meridian-token on POST /api/* and ?token= on /ws
UI_ORIGIN=http://localhost:3000
